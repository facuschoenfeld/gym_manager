{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos de la ventana principal",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://wa.me/*" }]
    },
    "sql:default",
    "sql:allow-execute",
    "dialog:default",
    "fs:allow-write-file",
    "notification:default",
    "log:default",
    "process:allow-restart"
  ]
}
